{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EnergyDatabase": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },
  "Seed": {
    "DataDirectory": "data"
  },
  "Plant": {
    "UtcOffset": "-05:00"
  },
  "Analysis": {
    "Pacing": {
      "MinimumStageDuration": "00:00:00.350"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
